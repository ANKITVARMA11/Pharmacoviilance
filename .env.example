# Copy this file to `.env` and fill in your key. `.env` is git-ignored; this example is safe to share.
NVIDIA_API_KEY=

# PV_MODEL=
# NIM_MIN_INTERVAL=1.5

# Seconds to wait for one answer before a model counts as stalled and the next one is tried.
# NIM_TIMEOUT=90
# NIM_MAX_MODEL_TRIES=10
# OPENFDA_API_KEY=
# NIM_BASE_URL=http://localhost:8000/v1
# PV_PROVIDER=nim
# OLLAMA_HOST=http://localhost:11434
# PV_DATA=data

# Day 3 crew. How many times the Critic may send a case back to Intake for another try.
# CREW_MAX_REVISIONS=1
# The monitor window (live agent chat) that opens with the Streamlit page. Port, and switches to turn it off.
# PV_MONITOR_PORT=8765
# PV_MONITOR=on
# PV_MONITOR_OPEN=on
